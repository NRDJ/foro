<?xml version="1.0" encoding="UTF-8"?>
<!-- Arquetipo Maven de los microservicios del foro.
     Instalar:  mvn -f arquetipo/pom.xml install
     Generar:   mvn archetype:generate -DarchetypeGroupId=com.duoc.foro -DarchetypeArtifactId=foro-microservicio-archetype
                -DarchetypeVersion=1.0.0 -DartifactId=ms-ejemplo -Dpackage=com.duoc.foro.ejemplo
                -DprefijoClase=MsEjemplo -Dpuerto=8090 "-Ddescripcion=Microservicio de ejemplo" -DinteractiveMode=false -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.duoc.foro</groupId>
    <artifactId>foro-microservicio-archetype</artifactId>
    <version>1.0.0</version>
    <packaging>maven-archetype</packaging>
    <name>Arquetipo de microservicio del foro</name>
    <description>Plantilla Spring Boot con capas, seguridad JWT, errores JSON, Oracle, pruebas con H2 y Dockerfile</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <extensions>
            <extension>
                <groupId>org.apache.maven.archetype</groupId>
                <artifactId>archetype-packaging</artifactId>
                <version>3.3.1</version>
            </extension>
        </extensions>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-archetype-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <!-- No interpretar ${...} al copiar: las plantillas se procesan al generar el proyecto -->
                    <addDefaultExcludes>false</addDefaultExcludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
